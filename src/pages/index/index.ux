<template>
  <div class="page" onswipe="swipe">
    <div if="{{mode === 'title'}}" class="title-art">
      <image class="title-background" src="/common/title_bg.jpg" onerror="backgroundError"></image>
      <image class="title-logo" src="/common/title_logo.png"></image>
    </div>
    <div if="{{mode === 'play'}}" class="art" onclick="advance">
      <image class="background" src="{{backgroundSrc}}" onerror="backgroundError" oncomplete="backgroundLoaded"></image>
      <image if="{{bodySrc !== ''}}" class="body" style="width: {{portraitWidth}}px; height: {{portraitHeight}}px; top: {{portraitTop}}px; left: {{portraitLeft}}px; opacity: {{portraitOpacity}};" src="{{bodySrc}}"></image>
      <image if="{{bodySecond !== ''}}" class="body" style="width: {{portraitSecondWidth}}px; height: {{portraitSecondHeight}}px; top: {{portraitSecondTop}}px; left: {{portraitSecondLeft}}px; opacity: {{portraitSecondOpacity}};" src="{{bodySecond}}"></image>
      <image if="{{bodyThird !== ''}}" class="body" style="width: {{portraitThirdWidth}}px; height: {{portraitThirdHeight}}px; top: {{portraitThirdTop}}px; left: {{portraitThirdLeft}}px; opacity: {{portraitThirdOpacity}};" src="{{bodyThird}}"></image>
    </div>
    <div if="{{mode === 'title'}}" class="title-panel">
      <div class="title-slot"><div if="{{trueUnlocked}}" class="title-button" onclick="startTrue"><image class="title-true" src="/common/title_true_end.png"></image></div></div>
      <div class="title-button" onclick="startNew"><image class="title-start" src="/common/title_start.png"></image></div>
      <div class="title-button" onclick="continueGame"><image class="title-load" src="/common/title_load.png"></image></div>
      <div class="title-button" onclick="openGallery"><image class="title-gallery" src="/common/title_gallery.png"></image></div>
      <div class="title-button" onclick="exitApplication"><image class="title-exit" src="/common/title_exit.png"></image></div>
    </div>
    <image if="{{mode === 'play'}}" class="dialogue-backdrop" src="/common/dialogue_bg.jpg"></image>
    <div if="{{mode === 'play'}}" class="dialogue-panel">
      <div class="speaker-row"><div class="speaker-cell"><text  class="speaker">{{speakerFont !== 'atrifont' ? speaker : ''}}</text><text  class="speaker embedded-text">{{speakerFont === 'atrifont' ? speaker : ''}}</text></div><div class="chapter-cell"><text  class="chapter">{{chapterFont !== 'atrifont' ? chapterLabel : ''}}</text><text  class="chapter embedded-text">{{chapterFont === 'atrifont' ? chapterLabel : ''}}</text></div></div>
      <scroll id="dialogue-scroll" class="dialogue-scroll" scroll-y="true" ontouchstart="dialogueTouchStart" ontouchmove="dialogueTouchMove" ontouchend="dialogueTouchEnd" onscroll="dialogueScrolled" onclick="dialogueTap"><div class="dialogue-content" style="height: {{dialogueHeight}}px;"><text  class="dialogue" style="font-size: {{fontSize}}px;line-height: {{fontSize === 26 ? 36 : 32}}px;">{{dialogueFont !== 'atrifont' ? displayText : ''}}</text><text  class="dialogue embedded-text" style="font-size: {{fontSize}}px;line-height: {{fontSize === 26 ? 36 : 32}}px;">{{dialogueFont === 'atrifont' ? displayText : ''}}</text></div></scroll>
      <div class="toolbar"><text class="tool" onclick="goBack">上一句</text><text class="tool" onclick="showMenu">菜单</text><text class="tool" onclick="advance">下一句 ›</text></div>
    </div>
    <div if="{{mode === 'choice'}}" class="choice-panel">
      <text class="choice-title">选择下一步</text>
      <scroll class="choice-list" scroll-y="true"><div for="{{options}}" tid="text"><text if="{{$item.font !== 'atrifont'}}"   class="choice" style="color: {{$item.disabled ? '#8eaac0' : '#176690'}};" onclick="pick($idx)">{{$item.text}}</text><text if="{{$item.font === 'atrifont'}}"   class="choice embedded-text" style="color: {{$item.disabled ? '#8eaac0' : '#176690'}};" onclick="pick($idx)">{{$item.text}}</text></div></scroll>
      <text class="small-action" onclick="showMenu">菜单</text>
    </div>
    <div if="{{mode === 'menu'}}" class="overlay">
      <text class="menu-title">阅读菜单</text>
      <text class="menu-action reading-action" onclick="saveGame">保存进度</text>
      <text class="menu-action reading-action" onclick="loadGame">读取进度</text>
      <text class="menu-action reading-action" style="color: {{hasNextChapter ? '#176690' : '#8eaac0'}};" onclick="goNextChapter">下一章 ›</text>
      <text class="menu-action reading-action" onclick="toggleAuto">{{autoLabel}}</text>
      <text class="menu-action reading-action" onclick="cycleAutoSpeed">{{autoSpeedLabel}}</text>
      <text class="menu-action reading-action" onclick="toggleSpeed">{{speedLabel}}</text>
      <text class="menu-action reading-action" onclick="toggleFont">{{fontLabel}}</text>
      <text class="menu-action reading-action" onclick="resume">返回游戏</text>
      <text class="menu-action reading-action muted" onclick="toTitle">返回标题</text>
    </div>
    <div if="{{mode === 'slots'}}" class="full-panel">
      <text class="panel-title">{{slotTitle}}</text>
      <text class="panel-subtitle">{{slotPageLabel}}</text>
      <div class="slot-list">
        <div for="{{slotRows}}" tid="number" class="slot-card" style="background-color: {{$item.occupied ? '#d8eaf5' : '#e5f1f8'}};" ontouchstart="beginSlotHold($item.index)" ontouchmove="moveSlotHold" ontouchend="clearSlotHold" ontouchcancel="clearSlotHold" onclick="selectSlot($item.index)">
          <text class="slot-title">{{$item.title}}</text><div class="slot-meta-cell"><text  class="slot-meta">{{$item.metaFont !== 'atrifont' ? $item.meta : ''}}</text><text  class="slot-meta embedded-text">{{$item.metaFont === 'atrifont' ? $item.meta : ''}}</text></div><div class="slot-preview-cell"><text  class="slot-preview">{{$item.previewFont !== 'atrifont' ? $item.preview : ''}}</text><text  class="slot-preview embedded-text">{{$item.previewFont === 'atrifont' ? $item.preview : ''}}</text></div>
        </div>
      </div>
      <div class="pager"><text class="pager-action" onclick="previousSlotPage">‹ 上一页</text><text class="pager-action" onclick="closeSlots">返回</text><text class="pager-action" onclick="nextSlotPage">下一页 ›</text></div>
    </div>
    <div if="{{mode === 'overwrite'}}" class="overlay">
      <text class="menu-title">{{overwriteTitle}}</text>
      <div class="confirm-cell" style="height: {{overwriteHeight}}px;"><text  class="confirm-text">{{overwriteFont !== 'atrifont' ? overwriteDetail : ''}}</text><text  class="confirm-text embedded-text">{{overwriteFont === 'atrifont' ? overwriteDetail : ''}}</text></div>
      <text class="menu-action" onclick="confirmOverwrite">确认覆盖</text><text class="menu-action muted" onclick="cancelOverwrite">取消</text>
    </div>
    <div if="{{mode === 'deleteSlot'}}" class="overlay">
      <text class="menu-title">{{deleteSlotTitle}}</text>
      <text class="panel-subtitle">删除后无法恢复</text>
      <text class="menu-action" ontouchstart="beginSlotTouch" onclick="confirmDeleteSlot">确认删除</text>
      <text class="menu-action muted" onclick="cancelDeleteSlot">取消</text>
    </div>
    <div if="{{mode === 'gallery'}}" class="full-panel">
      <text class="panel-title">CG 鉴赏</text><text class="panel-subtitle">{{galleryPageLabel}}</text>
      <div class="gallery-row"><div for="{{galleryTop}}" tid="image" class="gallery-card" onclick="viewCg($item.index)"><image class="gallery-thumb" src="{{$item.src}}"></image><text if="{{$item.font !== 'atrifont'}}"  class="gallery-caption">{{$item.label}}</text><text if="{{$item.font === 'atrifont'}}"  class="gallery-caption embedded-text">{{$item.label}}</text></div></div>
      <div class="gallery-row"><div for="{{galleryBottom}}" tid="image" class="gallery-card" onclick="viewCg($item.index)"><image class="gallery-thumb" src="{{$item.src}}"></image><text if="{{$item.font !== 'atrifont'}}"  class="gallery-caption">{{$item.label}}</text><text if="{{$item.font === 'atrifont'}}"  class="gallery-caption embedded-text">{{$item.label}}</text></div></div>
      <div class="pager"><text class="pager-action" onclick="previousGalleryPage">‹ 上一页</text><text class="pager-action" onclick="toTitle">返回标题</text><text class="pager-action" onclick="nextGalleryPage">下一页 ›</text></div>
    </div>
    <div if="{{mode === 'cg'}}" class="cg-panel">
      <image class="cg-image" src="{{cgSrc}}" onclick="cycleCg"></image><text if="{{cgFont !== 'atrifont'}}"  class="cg-caption">{{cgLabel}}</text><text if="{{cgFont === 'atrifont'}}"  class="cg-caption embedded-text">{{cgLabel}}</text>
      <div class="cg-controls"><text class="pager-action" onclick="previousCg">‹ 上一组</text><text class="pager-action" onclick="backToGallery">返回列表</text><text class="pager-action" onclick="nextCg">下一组 ›</text></div>
    </div>
    <div if="{{mode === 'end'}}" class="end-panel"><text class="game-title">{{endingLabel}}</text><text class="subtitle">可返回标题重新开始游戏</text><text class="action" onclick="toTitle">返回标题</text></div>
    <div if="{{mode === 'error'}}" class="overlay"><text class="menu-title">暂时无法继续</text><text class="error-text">{{errorText}}</text><text class="action" onclick="toTitle">返回标题</text></div>
    <text if="{{loading}}" class="loading">加载中…</text>
  </div>
</template>
<script>
import file from '@system.file';
import storage from '@system.storage';
import prompt from '@system.prompt';
import {graph} from '../../common/graph.js';
import {create,checkpoint,restore,locate,advance,choose,skipChapter,previous,trueAvailable,startTrue as enterTrue} from '../../common/engine.js';
import {textFont} from '../../common/text-font.js';
import {autoSpeeds,autoWait} from '../../common/auto-reader.js';
const PREFIX='atri_band8pro_';
const FONT='';
export default {
  private:{mode:'title',backgroundSrc:'/common/title_bg.jpg',bodySrc:'',bodySecond:'',bodyThird:'',portraitWidth:200,portraitHeight:286,portraitTop:0,portraitLeft:116,portraitSecondWidth:200,portraitSecondHeight:286,portraitSecondTop:0,portraitSecondLeft:216,portraitThirdWidth:144,portraitThirdHeight:286,portraitThirdTop:0,portraitThirdLeft:288,portraitOpacity:1,portraitSecondOpacity:1,portraitThirdOpacity:1,
    speaker:'',displayText:'',dialogueHeight:152,chapterLabel:'',speakerFont:FONT,dialogueFont:FONT,chapterFont:FONT,overwriteFont:FONT,cgFont:FONT,options:[],loading:true,errorText:'',hasNextChapter:true,fontSize:22,textSpeed:0,autoEnabled:false,autoSpeed:1,autoLabel:'自动播放：关闭',autoSpeedLabel:'自动速度：标准',speedLabel:'显示速度：即时',fontLabel:'字号：标准',trueUnlocked:false,slotTitle:'',slotPage:0,slotPageLabel:'',slotRows:[],storageBusy:false,deleteSlotTitle:'',overwriteTitle:'',overwriteHeight:30,overwriteDetail:'',endingLabel:'阅读完毕',galleryPage:0,galleryPageLabel:'',galleryTop:[],galleryBottom:[],cgIndex:0,cgVariant:0,cgSrc:'',cgLabel:''},
  onInit(){
    this.session=create(graph);this.sequence=0;this.slotSequence=0;this.timer=null;this._autoTimer=null;this._autoGeneration=0;this._alive=true;this._touchReading=false;this._dialogueDragged=false;this._dialogueTouch=null;this.fullText='';this.cachedFile='';this.frames=[];this._progress={};this._progressReady=false;this._progressBusy=false;this._progressDirty=false;this._slotData=[];this._slotLongPressed=false;this._slotHoldTimer=null;this._slotTouch=null;this._pendingDeleteSlot=null;this._gallery=[];this._hidden=false;
    storage.get({key:PREFIX+'settings_v1',default:'',success:data=>{try{const s=JSON.parse(data);this.fontSize=s.fontSize===26?26:22;this.textSpeed=s.textSpeed===30?30:0;this.autoSpeed=s.autoSpeed===0||s.autoSpeed===2?s.autoSpeed:1;this.refreshSettings();}catch(e){}},fail:()=>{},complete:()=>{}});
    storage.get({key:PREFIX+'progress_v1',default:'{}',success:data=>{try{const p=JSON.parse(data||'{}');this._progress=p&&typeof p==='object'?p:{};this._progressReady=true;this.loading=false;this.refreshProgress();}catch(e){this.fail('通关记录读取失败');}},fail:()=>{this.fail('通关记录读取失败，请返回标题重试');},complete:()=>{}});
    console.log('ATRI_BAND8PRO title ready');
  },
  onShow(){this._hidden=false;this.armAuto();},
  onHide(){this.clearSlotHold();this._hidden=true;this._touchReading=false;this.clearTyping();if(this.mode==='play')this.displayText=this.fullText;},
  onDestroy(){this.clearSlotHold();this._alive=false;this.stopAuto();this.clearTyping();this.sequence++;this.slotSequence++;console.log('ATRI_BAND8PRO destroyed');},
  exitApplication(){if(this.loading||this.storageBusy)return;this._alive=false;this.stopAuto();this.clearTyping();this.sequence++;this.slotSequence++;console.log('ATRI_BAND8PRO exit requested');this.$app.exit();},
  backgroundLoaded(){},backgroundError(){console.error('ATRI_BAND8PRO image failed',this.backgroundSrc);},
  clearTyping(){this.clearAuto();if(this.timer!==null){clearTimeout(this.timer);this.timer=null;}},
  clearAuto(){if(this._autoTimer!=null)clearTimeout(this._autoTimer);this._autoTimer=null;this._autoGeneration=(this._autoGeneration||0)+1;},
  canAuto(){return this.autoEnabled&&this._alive&&!this._hidden&&!this._touchReading&&!this.loading&&!this.storageBusy&&this.mode==='play'&&this.timer===null&&this.displayText===this.fullText;},
  armAuto(){
    this.clearAuto();if(!this.canAuto())return;
    const generation=this._autoGeneration,node=this.session.node,index=this.session.index;
    this._autoTimer=setTimeout(()=>{if(generation!==this._autoGeneration)return;this._autoTimer=null;if(!this.canAuto()||this.session.node!==node||this.session.index!==index)return;console.log('ATRI_BAND8PRO auto advance',node,index);this.advance();},autoWait(this.autoSpeed,this.fullText.length));
  },
  stopAuto(){this.autoEnabled=false;this.clearAuto();this.refreshSettings();},
  toggleAuto(){if(this.mode!=='menu')return;this.autoEnabled=!this.autoEnabled;this.clearAuto();this.refreshSettings();console.log('ATRI_BAND8PRO auto enabled',this.autoEnabled);},
  cycleAutoSpeed(){this.autoSpeed=(this.autoSpeed+1)%3;this.refreshSettings();this.persistSettings();console.log('ATRI_BAND8PRO auto speed',this.autoSpeed);},
  refreshProgress(){this.trueUnlocked=trueAvailable(graph,{progress:this._progress});},
  syncProgress(){if(this.session.progression==='chapter')return;const p=this.session.progress;if(JSON.stringify(p)!==JSON.stringify(this._progress)){this._progress=JSON.parse(JSON.stringify(p));this._progressDirty=true;this.refreshProgress();this.writeProgress();}},
  writeProgress(){if(this._progressBusy||!this._progressDirty)return;this._progressBusy=true;this._progressDirty=false;storage.set({key:PREFIX+'progress_v1',value:JSON.stringify(this._progress),success:()=>{this._progressBusy=false;this.writeProgress();},fail:()=>{this._progressBusy=false;this._progressDirty=true;this.toast('通关记录保存失败');},complete:()=>{}});},
  startNew(){if(this.loading||!this._progressReady)return;this.session=create(graph,this._progress);this.session.progression='story';this.cachedFile='';this.renderFrame();},
  startTrue(){if(this.loading)return;const state=create(graph,this._progress);if(!enterTrue(graph,state)){this.toast('完成好结局和坏结局后解锁');return;}state.history=[];state.progression='story';this.session=state;this.cachedFile='';this.renderFrame();},
  renderFrame(){
    this.clearTyping();let location;
    try{location=locate(graph,this.session);this.syncProgress();}catch(e){this.fail(e.message);return;}
    if(location.type==='choice'){this.loading=false;this.options=location.items.map(x=>Object.assign({},x,{font:textFont(x.text)}));this.mode='choice';console.log('ATRI_BAND8PRO choice',this.session.node,this.session.flag);return;}
    if(location.type==='end'){this.stopAuto();this.loading=false;this.mode='end';this.endingLabel=(this.chapterLabel||'故事')+' · 阅读完毕';this.cachedFile='';this.frames=[];console.log('ATRI_BAND8PRO ending',this.session.flag,JSON.stringify(this.session.progress),this.endingLabel);return;}
    this.chapterLabel=location.title;this.chapterFont=textFont(location.title);this.hasNextChapter=true;
    if(this.cachedFile===location.file){this.showFrame(this.frames[location.index]);return;}
    this.loading=true;const token=++this.sequence;
    file.readText({uri:'/common/story/'+location.file,success:data=>{if(token!==this.sequence)return;try{const frames=JSON.parse(data.text);if(!Array.isArray(frames)||!frames[location.index])throw Error('剧情数据格式错误');this.frames=frames;this.cachedFile=location.file;this.showFrame(frames[location.index]);}catch(e){this.fail(e.message);}},fail:(data,code)=>{if(token===this.sequence)this.fail('剧情读取失败：'+code);},complete:()=>{}});
  },
  showFrame(frame){
    if(!frame){this.fail('剧情下标无效');return;}this.loading=false;this.mode='play';this.backgroundSrc=frame.art.background;
    const sprites=frame.art.sprites||[],names=['','Second','Third'];
    for(let i=0;i<3;i++){const s=sprites[i]||{src:'',width:1,height:1,left:0,top:0},suffix=names[i];this[i===0?'bodySrc':'body'+suffix]=s.src;this['portrait'+suffix+'Width']=s.width;this['portrait'+suffix+'Height']=s.height;this['portrait'+suffix+'Left']=s.left;this['portrait'+suffix+'Top']=s.top;this['portrait'+suffix+'Opacity']=s.opacity===undefined?1:s.opacity;}
    this.speaker=frame.speaker;this.fullText=frame.text;this.speakerFont=textFont(frame.speaker);this.dialogueFont=textFont(frame.text);this.sizeDialogue();this.session.preview=frame.text.slice(0,80);this.displayText='';console.log('ATRI_BAND8PRO frame',this.session.node,this.session.index);
    // Recreate the scroll content by scene key in the template; scrollTo also
    // resets firmware versions that retain the previous scroll offset.
    this._touchReading=false;this._dialogueDragged=false;this._dialogueTouch=null;
    try{this.$element('dialogue-scroll').scrollTo({index:0});}catch(e){}
    const speed=this.autoEnabled?30:this.textSpeed;
    if(speed===0||this._hidden){this.displayText=this.fullText;this.armAuto();return;}
    const tick=()=>{if(!this._alive||this._hidden||this.mode!=='play')return;this.displayText=this.fullText.slice(0,this.displayText.length+1);if(this.displayText.length<this.fullText.length)this.timer=setTimeout(tick,speed);else{this.timer=null;this.armAuto();}};tick();
  },
  sizeDialogue(){const columns=this.fontSize===26?11:14;const lines=String(this.fullText||'').split('\n').reduce((count,line)=>count+Math.max(1,Math.ceil(line.length/columns)),0);this.dialogueHeight=Math.max(152,lines*(this.fontSize===26?36:32));},
  advance(){if(this.loading||this.mode!=='play')return;this.clearAuto();if(this.timer!==null){this.clearTyping();this.displayText=this.fullText;this.armAuto();return;}try{advance(graph,this.session);this.renderFrame();}catch(e){this.fail(e.message);}},
  dialogueTouchStart(event){this._touchReading=true;this.clearAuto();const touch=event.touches&&event.touches[0];this._dialogueDragged=false;this._dialogueTouch=touch?{x:touch.clientX,y:touch.clientY}:null;},
  dialogueTouchMove(event){const touch=event.touches&&event.touches[0],start=this._dialogueTouch;if(touch&&start&&(Math.abs(touch.clientX-start.x)>10||Math.abs(touch.clientY-start.y)>10))this._dialogueDragged=true;},
  dialogueTouchEnd(){this._touchReading=false;this.armAuto();},
  dialogueTap(){if(!this._dialogueDragged)this.advance();},
  dialogueScrolled(){if(this.mode==='play')this.armAuto();},
  pick(index){if(this.loading||this.mode!=='choice')return;try{const selected=this.options[index];choose(graph,this.session,index);console.log('ATRI_BAND8PRO picked',selected?selected.text:'',this.session.flag,this.session.node);this.renderFrame();}catch(e){this.fail(e.message);}},
  goBack(){if(this.loading||this.mode!=='play')return;this.stopAuto();try{previous(graph,this.session);this.renderFrame();}catch(e){this.fail(e.message);}},
  showMenu(){if(this.loading||!this.session)return;this.clearTyping();this.displayText=this.fullText;this.resumeMode=this.mode;this.mode='menu';console.log('ATRI_BAND8PRO menu');},
  resume(){this.mode=this.resumeMode||'play';this.armAuto();},
  goNextChapter(){if(this.loading||this.mode!=='menu')return;try{skipChapter(graph,this.session);this.renderFrame();}catch(e){this.fail(e.message);}},
  swipe(event){if(this.mode==='play'&&event.direction==='left')this.advance();},
  continueGame(){this.openSlots('load');},saveGame(){this.openSlots('save');},loadGame(){this.openSlots('load');},
  openSlots(role){if(this.loading||this.storageBusy)return;this.clearTyping();this._slotRole=role;this._slotsReturnMode=this.mode==='menu'?(this.resumeMode||'play'):this.mode;this.mode='slots';this._slotLongPressed=false;this.slotPage=0;this.slotTitle=role==='save'?'选择保存栏位':'选择读取栏位';this._slotData=[];this.loading=true;const token=++this.slotSequence;
    const read=index=>{if(token!==this.slotSequence)return;if(index>=30){this.loading=false;this.refreshSlots();console.log('ATRI_BAND8PRO slots ready',role);return;}storage.get({key:PREFIX+'slot_v1_'+(index+1),default:'',success:data=>{if(token!==this.slotSequence)return;try{this._slotData[index]=data?JSON.parse(data):null;}catch(e){this._slotData[index]={invalid:true};}read(index+1);},fail:()=>{if(token!==this.slotSequence)return;this._slotData[index]=null;read(index+1);},complete:()=>{}});};read(0);
  },
  refreshSlots(){this.slotPageLabel='30 个栏位 · 第 '+(this.slotPage+1)+' / 8 页 · 长按删除';this.slotRows=[];for(let index=this.slotPage*4;index<Math.min(30,this.slotPage*4+4);index++){const saved=this._slotData[index],node=saved&&saved.state&&graph.nodes[saved.state.node];this.slotRows.push({index,number:index+1,title:'存档 '+('0'+(index+1)).slice(-2),occupied:!!saved,metaFont:textFont(node?node.title:''),previewFont:textFont(saved&&saved.state?saved.state.preview:''),meta:!saved?'空栏位':node?node.title:'存档无法读取',preview:saved&&saved.state?(saved.state.preview||'章节开头').slice(0,20):''});}},
  previousSlotPage(){if(!this.loading&&this.slotPage>0){this.slotPage--;this.refreshSlots();}},nextSlotPage(){if(!this.loading&&this.slotPage<7){this.slotPage++;this.refreshSlots();}},
  closeSlots(){if(this.storageBusy)return;this.clearSlotHold();this.slotSequence++;this.loading=false;this.mode=this._slotsReturnMode;this.armAuto();},
  beginSlotTouch(){this._slotLongPressed=false;},
  selectSlot(index){this.clearSlotHold();if(this.mode!=='slots'||this._slotLongPressed||this.loading||this.storageBusy)return;const saved=this._slotData[index];if(this._slotRole==='load'){if(!saved){this.toast('此栏位尚未保存');return;}try{this.session=restore(graph,saved.state);if(this.session.progression!=='chapter')this.session.progress=Object.assign({},this.session.progress,this._progress);this.cachedFile='';this.slotSequence++;console.log('ATRI_BAND8PRO slot loaded',index+1,this.session.node,this.session.index);this.renderFrame();}catch(e){this.toast('此存档无法读取');}return;}this._pendingSlot=index;this._pendingSave={version:1,state:checkpoint(this.session),savedAt:Date.now()};if(saved){this.overwriteTitle='覆盖存档 '+('0'+(index+1)).slice(-2)+'？';this.overwriteDetail=(saved.state&&saved.state.preview||'已有进度').slice(0,45);this.overwriteHeight=this.overwriteDetail.split('\n').reduce((n,line)=>n+Math.max(1,Math.ceil(line.length/14)),0)*30;this.overwriteFont=textFont(this.overwriteDetail);this.mode='overwrite';console.log('ATRI_BAND8PRO overwrite',index+1);return;}this.commitSlot();},
  beginSlotHold(index,event){
    this.clearSlotHold();
    this.beginSlotTouch();
    if(this.loading||this.storageBusy)return;
    const touch=event&&event.touches&&event.touches[0];
    this._slotTouch=touch?{x:touch.clientX,y:touch.clientY}:null;
    this._slotHoldTimer=setTimeout(()=>{
      this.clearSlotHold();
      this.requestDeleteSlot(index);
    },650);
  },
  moveSlotHold(event){
    const start=this._slotTouch,touch=event.touches&&event.touches[0];
    if(!start||!touch)return;
    if(Math.abs(touch.clientX-start.x)>10||Math.abs(touch.clientY-start.y)>10){
      this._slotLongPressed=true;
      this.clearSlotHold();
    }
  },
  clearSlotHold(){
    if(this._slotHoldTimer!==null)clearTimeout(this._slotHoldTimer);
    this._slotHoldTimer=null;
    this._slotTouch=null;
  },
  requestDeleteSlot(index){
    if(this.mode!=='slots'||this.loading||this.storageBusy)return;
    this._slotLongPressed=true;
    if(!this._slotData[index])return;
    this._pendingDeleteSlot=index;
    this.deleteSlotTitle='删除存档 '+('0'+(index+1)).slice(-2)+'？';
    this.mode='deleteSlot';
    console.log('ATRI_BAND8PRO delete confirm',index+1);
  },
  cancelDeleteSlot(){
    if(this.mode!=='deleteSlot'||this.storageBusy)return;
    this._pendingDeleteSlot=null;
    this.mode='slots';
  },
  confirmDeleteSlot(){
    if(this.mode!=='deleteSlot'||this._slotLongPressed||this.storageBusy)return;
    const index=this._pendingDeleteSlot;
    const sequence=this.slotSequence;
    this.storageBusy=true;
    this.loading=true;
    // An empty value removes this one key in Vela storage.
    storage.set({
      key:PREFIX+'slot_v1_'+(index+1),value:'',
      success:()=>{
        if(!this._alive||sequence!==this.slotSequence)return;
        this._slotData[index]=null;
        this._pendingDeleteSlot=null;
        this.refreshSlots();
        this.storageBusy=false;
        this.loading=false;
        this.mode='slots';
        this.toast('存档已删除');
        console.log('ATRI_BAND8PRO slot deleted',index+1);
      },
      fail:()=>{
        if(!this._alive||sequence!==this.slotSequence)return;
        this.storageBusy=false;
        this.loading=false;
        this.toast('删除失败，请重试');
      },
      complete:()=>{}
    });
  },
  confirmOverwrite(){this.commitSlot();},cancelOverwrite(){if(!this.storageBusy)this.mode='slots';},
  commitSlot(){if(this.storageBusy)return;this.storageBusy=true;this.loading=true;const index=this._pendingSlot;storage.set({key:PREFIX+'slot_v1_'+(index+1),value:JSON.stringify(this._pendingSave),success:()=>{this._slotData[index]=this._pendingSave;this.storageBusy=false;this.loading=false;this.mode=this._slotsReturnMode;this.toast('已保存到存档 '+('0'+(index+1)).slice(-2));console.log('ATRI_BAND8PRO slot saved',index+1,this.session.node,this.session.index);this.armAuto();},fail:()=>{this.storageBusy=false;this.loading=false;this.toast('保存失败，请重试');},complete:()=>{}});},
  openGallery(){if(this.loading)return;this.mode='gallery';if(this._gallery.length){this.refreshGallery();return;}this.loading=true;const token=++this.sequence;file.readText({uri:'/common/gallery.txt',success:data=>{if(token!==this.sequence)return;try{this._gallery=JSON.parse(data.text);this.galleryPage=0;this.loading=false;this.refreshGallery();}catch(e){this.fail('CG目录读取失败');}},fail:()=>{if(token===this.sequence)this.fail('CG目录读取失败');},complete:()=>{}});},
  refreshGallery(){const rows=this._gallery.slice(this.galleryPage*4,this.galleryPage*4+4).map((x,i)=>({image:x.variants[0],src:x.variants[0],index:this.galleryPage*4+i,label:x.label+'\n'+x.variants.length+' 张',font:textFont(x.label+'张')}));this.galleryTop=rows.slice(0,2);this.galleryBottom=rows.slice(2);this.galleryPageLabel=this._gallery.length+' 组 · 第 '+(this.galleryPage+1)+' / '+Math.ceil(this._gallery.length/4)+' 页';},
  previousGalleryPage(){if(this.galleryPage>0){this.galleryPage--;this.refreshGallery();}},nextGalleryPage(){if(this.galleryPage<Math.ceil(this._gallery.length/4)-1){this.galleryPage++;this.refreshGallery();}},
  viewCg(index){if(this.loading)return;this.cgIndex=index;this.cgVariant=0;this.mode='cg';this.renderCg();},
  renderCg(){const group=this._gallery[this.cgIndex];this.cgSrc=group.variants[this.cgVariant];this.cgLabel=group.label+' · '+(this.cgVariant+1)+' / '+group.variants.length+' · 点击切换';this.cgFont=textFont(this.cgLabel);console.log('ATRI_BAND8PRO cg',this.cgIndex,this.cgVariant);},cycleCg(){const group=this._gallery[this.cgIndex];this.cgVariant=(this.cgVariant+1)%group.variants.length;this.renderCg();},previousCg(){if(this.cgIndex>0)this.viewCg(this.cgIndex-1);},nextCg(){if(this.cgIndex<this._gallery.length-1)this.viewCg(this.cgIndex+1);},backToGallery(){this.galleryPage=Math.floor(this.cgIndex/4);this.mode='gallery';this.refreshGallery();},
  refreshSettings(){this.speedLabel=this.textSpeed===0?'显示速度：即时':'显示速度：逐字';this.fontLabel=this.fontSize===26?'字号：大':'字号：标准';this.autoLabel='自动播放：'+(this.autoEnabled?'开启':'关闭');this.autoSpeedLabel='自动速度：'+autoSpeeds[this.autoSpeed];},
  persistSettings(){storage.set({key:PREFIX+'settings_v1',value:JSON.stringify({fontSize:this.fontSize,textSpeed:this.textSpeed,autoSpeed:this.autoSpeed}),success:()=>{},fail:()=>{},complete:()=>{}});},toggleSpeed(){this.textSpeed=this.textSpeed===0?30:0;this.refreshSettings();this.persistSettings();},toggleFont(){this.fontSize=this.fontSize===22?26:22;this.sizeDialogue();this.refreshSettings();this.persistSettings();},
  toTitle(){if(this.storageBusy)return;this.stopAuto();this.syncProgress();this.writeProgress();this.clearTyping();this.sequence++;this.slotSequence++;this.loading=false;this.mode='title';this.cachedFile='';this.frames=[];this.backgroundSrc='/common/title_bg.jpg';this.bodySrc='';this.bodySecond='';this.bodyThird='';console.log('ATRI_BAND8PRO title ready');},
  toast(message){prompt.showToast({message,duration:1500,success:()=>{},fail:()=>{},complete:()=>{}});},
  fail(message){this.stopAuto();this.clearTyping();this.loading=false;this.mode='error';this.errorText=String(message);console.error('ATRI_BAND8PRO error',message);}
}
</script>

<style>
@font-face{font-family:atrifont;src:url('/common/atri-text.otf');}
.embedded-text{font-family:atrifont;}
.page{width:336px;height:480px;background-color:#edf7fc;flex-direction:column;}
.art{position:absolute;top:0px;left:0px;width:336px;height:224px;justify-content:center;align-items:center;background-color:#000000;}
.background{width:336px;height:224px;object-fit:contain;}
.body{position:absolute;top:0px;object-fit:contain;}
.title-art,.title-background{position:absolute;top:0px;left:0px;width:336px;height:480px;}
.title-logo{position:absolute;top:10px;left:12px;width:152px;height:68px;object-fit:contain;}
.title-panel{position:absolute;top:210px;left:0px;width:336px;height:248px;padding:0px 34px;flex-direction:column;}
.title-slot,.title-button{width:268px;height:48px;flex-shrink:0;}
.title-button{flex-direction:row;justify-content:flex-start;align-items:center;}
.dialogue-backdrop{position:absolute;top:224px;left:0px;width:336px;height:256px;}
.dialogue-panel{position:absolute;top:224px;left:0px;width:336px;height:256px;padding:12px 14px;flex-direction:column;}
.speaker-row{height:30px;width:308px;flex-direction:row;flex-shrink:0;margin-bottom:8px;}
.speaker-cell{width:164px;height:30px;flex-shrink:0;}
.chapter-cell{width:144px;height:30px;flex-shrink:0;}
.speaker{position:absolute;top:0px;left:0px;width:164px;height:30px;font-size:22px;color:#167eae;}
.chapter{position:absolute;top:0px;left:0px;width:144px;height:30px;font-size:14px;color:#6d91aa;text-align:right;}
.dialogue-scroll{width:308px;height:152px;flex-shrink:0;}
.dialogue-content{width:308px;flex-shrink:0;flex-direction:column;}
.dialogue{position:absolute;top:0px;left:0px;width:308px;flex-shrink:0;color:#173f5b;line-height:32px;}
.toolbar{height:42px;width:308px;justify-content:space-between;align-items:center;}
.tool{font-size:19px;color:#185979;padding:8px;}
.choice-panel{position:absolute;top:0px;left:0px;width:336px;height:480px;background-color:#edf7fc;padding:14px;flex-direction:column;}
.choice-title{font-size:23px;color:#176690;margin-bottom:8px;text-align:center;}
.choice-list{width:308px;height:390px;flex-direction:column;}
.choice{height:64px;width:308px;background-color:#d8eaf5;border-radius:12px;font-size:19px;line-height:25px;color:#176690;text-align:center;margin-bottom:8px;}
.small-action{font-size:18px;color:#6d91aa;text-align:center;}
.overlay{position:absolute;top:0px;left:0px;width:336px;height:480px;background-color:#edf7fc;flex-direction:column;padding:18px 14px;}
.menu-title{height:36px;font-size:26px;color:#176690;text-align:left;margin-bottom:10px;flex-shrink:0;}
.menu-action{height:46px;width:308px;font-size:21px;color:#176690;background-color:#dfedf6;border-radius:8px;margin-bottom:8px;text-align:left;padding-left:12px;}
.reading-action{height:38px;margin-bottom:5px;font-size:20px;flex-shrink:0;}
.muted{color:#6d91aa;}
.full-panel{position:absolute;top:0px;left:0px;width:336px;height:480px;background-color:#edf7fc;flex-direction:column;padding:14px;}
.panel-title{height:34px;font-size:25px;color:#176690;text-align:left;margin-bottom:4px;}
.panel-subtitle{height:22px;font-size:15px;color:#6d91aa;text-align:left;margin-bottom:6px;}
.slot-list{height:336px;width:308px;flex-direction:column;}
.slot-card{height:78px;width:308px;margin-bottom:6px;padding:6px 10px;flex-direction:column;border-radius:12px;flex-shrink:0;}
.slot-title{height:24px;font-size:21px;color:#175d85;}
.slot-meta-cell{height:18px;width:288px;flex-shrink:0;}
.slot-preview-cell{height:20px;width:288px;flex-shrink:0;}
.slot-meta{position:absolute;top:0px;left:0px;width:288px;height:18px;font-size:15px;color:#6d91aa;}
.slot-preview{position:absolute;top:0px;left:0px;width:288px;height:20px;font-size:16px;color:#3b769b;}
.pager{height:44px;width:308px;justify-content:space-between;align-items:center;}
.pager-action{font-size:17px;color:#2075a4;padding:7px;}
.gallery-row{height:168px;width:308px;justify-content:space-between;}
.gallery-card{height:160px;width:148px;padding:6px;flex-direction:column;background-color:#e2eff7;border-radius:12px;}
.gallery-thumb{height:100px;width:136px;object-fit:contain;background-color:#000000;}
.gallery-caption{height:48px;width:136px;font-size:15px;line-height:22px;color:#176690;text-align:center;}
.cg-panel{position:absolute;top:0px;left:0px;width:336px;height:480px;flex-direction:column;background-color:#edf7fc;}
.cg-image{width:336px;height:380px;object-fit:contain;}
.cg-caption{width:336px;height:38px;font-size:15px;color:#176690;text-align:center;}
.cg-controls{width:336px;height:62px;padding:0px 8px;justify-content:space-between;align-items:center;background-color:#edf7fc;}
.confirm-cell{width:308px;margin:24px 0px;flex-shrink:0;}
.confirm-text{position:absolute;top:0px;left:0px;width:308px;font-size:21px;color:#176690;margin:0px;}
.error-text{width:308px;font-size:20px;color:#ac5966;margin-bottom:24px;}
.loading{position:absolute;top:216px;left:80px;width:176px;height:46px;text-align:center;font-size:21px;color:#176690;background-color:#d2e8f5;border-radius:12px;}
.end-panel{position:absolute;top:224px;left:0px;width:336px;height:256px;padding:12px 14px;flex-direction:column;}
.game-title{font-size:24px;color:#173f5b;text-align:center;margin-bottom:6px;}
.subtitle{font-size:17px;color:#6d91aa;text-align:center;margin-bottom:10px;}
.action{height:50px;width:308px;margin-bottom:8px;color:#176690;background-color:#d8eaf5;border-radius:12px;text-align:center;font-size:22px;}


.title-true{width:165px;height:25px;object-fit:contain;}
.title-start{width:105px;height:25px;object-fit:contain;}
.title-load{width:88px;height:25px;object-fit:contain;}
.title-gallery{width:106px;height:25px;object-fit:contain;}
.title-exit{width:71px;height:25px;object-fit:contain;}</style>
